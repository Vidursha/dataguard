# DataGuard local configuration. Copy to .env (never commit .env):
#   python wso2\scripts\generate_env.py
# generates .env from this file and fills empty secrets with random values.

# Shared secret the WSO2 gateway adds to every backend call (header
# X-DataGuard-Gateway-Secret). The backend rejects requests without it.
GATEWAY_SHARED_SECRET=change-me-to-a-long-random-value-at-least-32-chars

# WSO2 API Manager admin account (out-of-the-box local default, dev only)
WSO2_ADMIN_USERNAME=admin
WSO2_ADMIN_PASSWORD=admin

# Passwords for the DataGuard test users created by the setup scripts
ANALYST1_PASSWORD=change-me-analyst
MANAGER1_PASSWORD=change-me-manager
# Service account that owns the "AI Agent" application (never signs in)
AI_AGENT_SERVICE_PASSWORD=change-me-service

# Filled in by wso2\scripts\setup_all.py (OAuth2 client credentials of the
# "AI Agent" application; used by the security tests and your MCP client)
AI_AGENT_CLIENT_ID=
AI_AGENT_CLIENT_SECRET=
