# DataGuard settings for your computer. Never commit .env.
# To make .env from this file, run:
#   python wso2\scripts\generate_env.py
# It fills the empty secrets with random values.

# Secret that the WSO2 gateway adds to every call to the backend (in the
# X-DataGuard-Gateway-Secret header). Without it, the backend says no.
GATEWAY_SHARED_SECRET=change-me-to-a-long-random-value-at-least-32-chars

# WSO2 API Manager admin account (the default one, only for local use)
WSO2_ADMIN_USERNAME=admin
WSO2_ADMIN_PASSWORD=admin

# Passwords for the DataGuard test users that the setup scripts create
ANALYST1_PASSWORD=change-me-analyst
MANAGER1_PASSWORD=change-me-manager
# Service account that owns the "AI Agent" application (nobody signs in with it)
AI_AGENT_SERVICE_PASSWORD=change-me-service

# wso2\scripts\setup_all.py fills these in. They are the client ID and secret
# of the "AI Agent" application, used by the security tests and your MCP client.
AI_AGENT_CLIENT_ID=
AI_AGENT_CLIENT_SECRET=
